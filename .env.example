# TickFlow API Key (optional)
# 如果不提供,将使用免费API (https://free-api.tickflow.org)
# 完整服务需要API Key,使用 https://api.tickflow.org
VITE_TICKFLOW_API_KEY=

# 分析后端地址 (optional)
# 默认同源: vite dev/preview 把 /api 与 /ws 代理到 http://localhost:8899
# 后端换端口时: ANALYSIS_API_TARGET=http://localhost:9000 pnpm dev
# 前端直连独立部署时: VITE_ANALYSIS_API_URL=https://api.example.com
#                   VITE_ANALYSIS_WS_URL=wss://api.example.com/ws
VITE_ANALYSIS_API_URL=
VITE_ANALYSIS_WS_URL=

# Gemini API Key (required for AI analysis)
# 从 Google AI Studio 获取: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenRouter API Key (optional, for AI analysis)
# OpenRouter 支持多种 AI 模型,包括 Gemini、Claude、GPT 等
# 从 OpenRouter 获取: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# AI Model (optional, for daily report CLI)
# 默认使用 google/gemini-2.0-flash-exp:free
AI_MODEL=

# OpenCode API Key (required for daily report CLI)
# 从 https://opencode.ai 获取
VITE_OPENCODE_API_KEY=

# Exa API Key (optional, 用于日报检索财联社新闻/热点)
# 从 https://exa.ai 获取
# 配置后日报会通过 Exa 检索 cls.cn 获取个股资讯与市场热点
EXA_API_KEY=

# Server酱 (微信推送, optional)
# 从 https://sct.ftqq.com/ 获取 SendKey
SERVERCHAN_KEY=

# 邮件通知 (通过 Resend API, optional)
# 从 https://resend.com/ 获取 API Key
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
