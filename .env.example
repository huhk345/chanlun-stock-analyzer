# TickFlow API Key (optional)
# 如果不提供,将使用免费API (https://free-api.tickflow.org)
# 完整服务需要API Key,使用 https://api.tickflow.org
VITE_TICKFLOW_API_KEY=

# Gemini API Key (required for AI analysis)
# 从 Google AI Studio 获取: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenRouter API Key (optional, for AI analysis)
# OpenRouter 支持多种 AI 模型,包括 Gemini、Claude、GPT 等
# 从 OpenRouter 获取: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
