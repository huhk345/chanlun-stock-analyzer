{
  "name": "chanlun-stock-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "server": "pnpm run server:py",
    "start": "vite & pnpm run server:py",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "py:setup": "python3 -m venv server-py/.venv && server-py/.venv/bin/pip install -r server-py/requirements-dev.txt",
    "server:py": "cd server-py && python3 -m chanlun_server serve",
    "test:py": "cd server-py && python3 run_tests.py",
    "test:py:unit": "cd server-py && python3 run_tests.py --part 1",
    "test:py:e2e": "cd server-py && python3 run_tests.py --part 3",
    "sync-index": "cp data/hs300/_constituents.json public/index-members.hs300.json && cp data/zz500/_constituents.json public/index-members.zz500.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dom-to-image-more": "^3.9.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.546.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.10",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
